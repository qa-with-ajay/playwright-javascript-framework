# Copy this file to .env.local and update values for your local/staging ERP.
# Never commit .env.local or real credentials.

BASE_URL=http://localhost:3000
API_URL=http://localhost:3000

# true = run browser with UI; false = headless
HEADLESS=false

# Milliseconds
TIMEOUT=30000
EXPECT_TIMEOUT=5000

# Set true only when this repository itself can start the application with `npm run dev`.
# For a separately hosted staging environment, leave false.
START_WEB_SERVER=false

# Add test account values to your private .env.local file when needed.
# ERP_ADMIN_EMAIL=
# ERP_ADMIN_PASSWORD=
# ERP_ROLE_CODE=