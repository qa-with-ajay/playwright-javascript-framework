# Copy this file to .env.local and update values for your local/staging ERP.
# Never commit .env.local or real credentials.

BASE_URL=http://localhost:3000
API_URL=http://localhost:3000

HEADLESS=true
TIMEOUT=30000
EXPECT_TIMEOUT=5000
START_WEB_SERVER=false

# Group Admin test account (role code defaults to ADMIN).
ERP_ADMIN_EMAIL=
ERP_ADMIN_PASSWORD=
ERP_ADMIN_ROLE_CODE=ADMIN

# Optional Unit Manager test account (role code defaults to UNIT_MANAGER).
ERP_MANAGER_EMAIL=
ERP_MANAGER_PASSWORD=
ERP_MANAGER_ROLE_CODE=UNIT_MANAGER

# Sales test account must have billing.read and billing.manage permissions.
ERP_SALES_EMAIL=
ERP_SALES_PASSWORD=
ERP_SALES_ROLE_CODE=ADMIN

# Optional PostgreSQL verification. Use a dedicated local test database only.
# The database name must contain "test" (for example kb_erp_test).
# Create this as a dedicated test database; do not point tests at a dev or production DB.
DATABASE_URL=postgresql://kb_user:ERP2345kb@localhost:5433/kb_erp_accounting_dev

ENABLE_DB_VERIFICATION=true
