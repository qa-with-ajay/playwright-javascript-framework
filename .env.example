# Copy this file to .env.local and update values for your dedicated local test environment.
# Never commit .env.local or real credentials.

BASE_URL=http://localhost:3000
API_URL=http://localhost:3000

HEADLESS=true
TIMEOUT=30000
EXPECT_TIMEOUT=5000
START_WEB_SERVER=false

# Group Admin test account. Set role code to an active role assigned to this account.
ERP_ADMIN_EMAIL=
ERP_ADMIN_PASSWORD=
ERP_ADMIN_ROLE_CODE=GROUP_ADMIN

# Unit Manager test account assigned to ERP_MANAGER_BUSINESS_UNIT_ID.
ERP_MANAGER_EMAIL=
ERP_MANAGER_PASSWORD=
ERP_MANAGER_ROLE_CODE=UNIT_MANAGER
ERP_MANAGER_BUSINESS_UNIT_ID=

# IDs from a separate test business unit and a product belonging to that unit.
# Use synthetic test records only; do not use IDs from production.
ERP_FORBIDDEN_BUSINESS_UNIT_ID=
ERP_CROSS_UNIT_PRODUCT_ID=

# Sales test account must have billing.read and billing.manage permissions.
ERP_SALES_EMAIL=
ERP_SALES_PASSWORD=
ERP_SALES_ROLE_CODE=ADMIN

# Optional PostgreSQL verification. Create a separate database named kb_erp_test.
# The helper rejects database names without a standalone "test" segment.
# Do not put production or valuable development credentials here.
DATABASE_URL=

ENABLE_DB_VERIFICATION=false
