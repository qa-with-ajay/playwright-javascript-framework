# Copy this file to .env.local and update values for your local/staging ERP.
# Never commit .env.local or real credentials.

BASE_URL=http://localhost:3000
API_URL=http://localhost:3000

HEADLESS=true
TIMEOUT=30000
EXPECT_TIMEOUT=5000
START_WEB_SERVER=false

# Group Admin test account (role code defaults to ADMIN).
ERP_ADMIN_EMAIL=
ERP_ADMIN_PASSWORD=
ERP_ADMIN_ROLE_CODE=ADMIN

# Optional Unit Manager test account (role code defaults to UNIT_MANAGER).
ERP_MANAGER_EMAIL=
ERP_MANAGER_PASSWORD=
ERP_MANAGER_ROLE_CODE=UNIT_MANAGER
