{
  "name": "playwright-erp-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable Playwright automation framework for KB ERP and other web applications",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "cucumber": "cucumber-js --config cucumber.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.0.6",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.4.5"
  },
  "dependencies": {
    "@cucumber/cucumber": "^12.8.3",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.3.1",
    "playwright": "^1.58.2",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2"
  }
}